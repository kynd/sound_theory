---
import { getCollection } from 'astro:content';
import Sidebar from '../components/Sidebar.astro';

export interface Props {
  title: string;
  slug: string;
  filePath: string;
}

const { title, slug, filePath } = Astro.props;

const allDocs = await getCollection('docs');

type TreeNode = {
  label: string;
  path: string; // hierarchical path (from doc.id) for active-state detection
  url: string;  // short slug URL for link hrefs
  children: Map<string, TreeNode>;
};

// Desired top-level section order (slug → position)
const SECTION_ORDER: Record<string, number> = {
  'drawing-with-code': 0,
  'sketching-with-math-and-quasi-physics': 1,
  'the-secrets-of-sound-for-kids': 2,
  'sound-theory': 2.5,
  'category-theory-and-code': 3,
  'on-prototyping-prototyping-is-sketching': 4,
  'faq': 5,
};

// Order for children of sketching-with-math-and-quasi-physics (matches index page)
const SKETCHING_ORDER: Record<string, number> = {
  'many-intros-for-sketching-with-code': 0,
  'newton-and-vectors': 1,
  'distance': 2,
  'rotation': 3,
  'wave': 4,
  'light': 5,
  'projection-and-3d-rendering': 6,
  'colors-and-numbers': 7,
  'image-processing': 8,
  '2d-feedback-systems': 9,
  'calculus-for-makers': 10,
  'patterns': 11,
  'curves': 12,
  'mapping': 13,
  'chaos-theory': 14,
  'reading': 15,
  'math-snippets': 16,
  'geometric-drawings': 17,
  'fourier-series': 18,
  'taming-randomness': 19,
  'interpolation-and-animation': 20,
  'vector-operations': 21,
  'detecting-collision': 22,
  'kinematics': 23,
  'numbers-and-intervals': 24,
  'mixing-colors': 25,
  'pencils-brushes-and-paints': 26,
  'physical-values-and-human-perception': 27,
  'resolution': 28,
  'dimensions': 29,
  'camera-in-action': 30,
  'drawing-landscape': 31,
  'reading-a-noise-function': 32,
  'filling-space-with-colors': 33,
  'neural-network': 34,
};

// Order for children of sound-theory (folder or file names under sound-theory/)
const SOUND_THEORY_ORDER: Record<string, number> = {
  'sound-sources': 0,
  'sound-waves': 1,
  'tuning-systems': 2,
  'scales': 3,
  'church-modes': 4,
  'minor-scales': 5,
  'other-scales': 6,
  'pulse-and-cycles': 7,
  'time-signatures': 8,
  'rhythm-and-feel': 9,
  'diatonic-chords': 10,
  'chord-types': 11,
  'seventh-chords': 12,
  'functional-harmony': 13,
  'tension-and-resolution': 14,
  'subdominant-minor': 15,
  'non-functional-harmony': 16,
  'reharmonization': 17,
  'breaking-conventions': 18,
  'sound-as-material': 19,
};

function buildTree(docs: typeof allDocs): TreeNode {
  const root: TreeNode = { label: 'root', path: '', url: '', children: new Map() };

  // Pre-build a map from hierarchical path → short slug URL
  const pathToUrl = new Map<string, string>();
  for (const doc of docs) {
    const fp = doc.id.replace(/\.md$/, '').replace(/\/index$/, '');
    pathToUrl.set(fp, doc.slug);
  }

  for (const doc of docs) {
    const fp = doc.id.replace(/\.md$/, '').replace(/\/index$/, '');
    if (fp === '' || fp === 'index') continue; // root homepage
    const parts = fp.split('/');
    let node = root;
    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      const nodePath = parts.slice(0, i + 1).join('/');
      if (!node.children.has(part)) {
        node.children.set(part, {
          label: i === parts.length - 1 ? (doc.data.title || part) : part,
          path: nodePath,
          url: pathToUrl.get(nodePath) || nodePath,
          children: new Map(),
        });
      } else if (i === parts.length - 1) {
        const existing = node.children.get(part)!;
        existing.label = doc.data.title || existing.label;
        existing.url = doc.slug;
      }
      node = node.children.get(part)!;
    }
  }

  // Sort root-level children by SECTION_ORDER
  const sorted = [...root.children.entries()].sort(([a], [b]) => {
    const oa = SECTION_ORDER[a] ?? 99;
    const ob = SECTION_ORDER[b] ?? 99;
    return oa - ob;
  });
  root.children = new Map(sorted);

  // Sort children of sketching-with-math-and-quasi-physics by SKETCHING_ORDER
  const sketchingNode = root.children.get('sketching-with-math-and-quasi-physics');
  if (sketchingNode) {
    const sortedSketching = [...sketchingNode.children.entries()].sort(([a], [b]) => {
      const oa = SKETCHING_ORDER[a] ?? 99;
      const ob = SKETCHING_ORDER[b] ?? 99;
      return oa - ob;
    });
    sketchingNode.children = new Map(sortedSketching);
  }

  // Sort children of sound-theory by SOUND_THEORY_ORDER
  const soundNode = root.children.get('sound-theory');
  if (soundNode) {
    const sortedSound = [...soundNode.children.entries()].sort(([a], [b]) => {
      const oa = SOUND_THEORY_ORDER[a] ?? 99;
      const ob = SOUND_THEORY_ORDER[b] ?? 99;
      return oa - ob;
    });
    soundNode.children = new Map(sortedSound);
  }

  return root;
}

const tree = buildTree(allDocs);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function buildBreadcrumbs(fp: string, docs: typeof allDocs) {
  const parts = fp.split('/').filter(Boolean);
  const crumbs: { label: string; href: string }[] = [
    { label: 'Home', href: base || '/' },
  ];

  let cumulative = '';
  for (let i = 0; i < parts.length; i++) {
    cumulative += (i > 0 ? '/' : '') + parts[i];
    const match = docs.find((d) => {
      const dfp = d.id.replace(/\.md$/, '').replace(/\/index$/, '');
      return dfp === cumulative;
    });
    crumbs.push({
      label: match?.data.title || parts[i],
      href: match ? `${base}/${match.slug}` : `${base}/${cumulative}`,
    });
  }
  return crumbs;
}

const breadcrumbs = buildBreadcrumbs(filePath, allDocs);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.25/dist/katex.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0&icon_names=link" />
  <script async src="//www.instagram.com/embed.js"></script>
  <script async src="https://cpwebassets.codepen.io/assets/embed/ei.js"></script>
  <script is:inline>
    (function() {
      var f = localStorage.getItem('font-mode') || 'serif';
      document.documentElement.setAttribute('data-font', f);
      // Set sidebar state before first paint to prevent flash of wrong state
      if (localStorage.getItem('sidebar-open') === 'true') {
        document.documentElement.classList.add('sidebar-open');
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Sans+JP:wght@300;400;500;600;700&family=Noto+Serif+JP:wght@400;500;600;700&family=Sora:wght@300;400;500;600;700&family=Google+Sans+Code:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    /* ── Reset & Base ─────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #ffffff;
      --fg: #343434;
      --fg-muted: #777777;
      --border: #e8e8e8;
      --link: rgb(49, 113, 222);
      --sidebar-width: 375px;
      --header-height: 64px;
      --font-body: 'Sora', 'Noto Sans JP', sans-serif;
      --font-code: 'Google Sans Code', 'Fira Mono', monospace;
    }
    html[data-font="serif"] {
      --font-body: 'Lora', 'Noto Serif JP', serif;
    }

    html, body {
      background: var(--bg);
      color: var(--fg);
      font-family: var(--font-body);
      font-size: 18px;
      line-height: 1.7;
      min-height: 100vh;
    }

    /* ── Layout Shell ─────────────────────────────────────────────── */
    .shell {
      display: flex;
      min-height: 100vh;
    }

    /* ── Top Bar ──────────────────────────────────────────────────── */
    .topbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--header-height);
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1rem;
      z-index: 100;
      pointer-events: none;
    }

    .topbar-controls {
      display: flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.76);
      border-radius: 8px;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      pointer-events: all;
    }
    .topbar-controls-left { padding: 0.22rem; }
    .topbar-controls-right { padding: 0.22rem 0.55rem; }

    .topbar-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--fg);
      border-radius: 5px;
      transition: background 0.15s;
      flex-shrink: 0;
    }
    .topbar-toggle:hover { background: rgba(0,0,0,0.06); }

    .topbar-font-switcher {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    .font-opt {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.2rem 0.1rem;
      font-size: 0.75rem;
      color: var(--fg-muted);
      letter-spacing: 0.01em;
      transition: color 0.15s;
    }
    .font-opt:hover { color: var(--fg); }
    .font-opt.active { color: var(--fg); font-weight: 600; }
    .font-sep { color: #ccc; font-size: 0.75rem; user-select: none; }

    /* ── Content breadcrumb ───────────────────────────────────────── */
    .content-breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.2rem 0.3rem;
      font-size: 0.75rem;
      color: var(--fg-muted);
      margin-bottom: 2.1rem;
    }
    .content-breadcrumb a {
      color: var(--fg-muted);
      text-decoration: none;
    }
    .content-breadcrumb a:hover { color: var(--fg); }
    .content-breadcrumb .cb-sep { color: #ccc; }

    /* ── Sidebar ──────────────────────────────────────────────────── */
    .sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.08);
      z-index: 98;
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-width);
      background: var(--bg);
      overflow-y: auto;
      z-index: 101;
      transform: translateX(calc(-1 * var(--sidebar-width)));
      transition: transform 0.22s ease;
      padding: 1rem 0 2rem;
    }

    .shell.sidebar-open .sidebar,
    html.sidebar-open .sidebar {
      transform: translateX(0);
      box-shadow: 4px 0 24px rgba(0,0,0,0.07);
    }

    .shell.no-transition .sidebar,
    .shell.no-transition .main-wrap {
      transition: none !important;
    }

    .shell.sidebar-open .sidebar-backdrop,
    html.sidebar-open .sidebar-backdrop {
      display: block;
    }

    /* ── Main Content ─────────────────────────────────────────────── */
    .main-wrap {
      flex: 1;
      margin-top: var(--header-height);
      margin-left: 0;
      transition: margin-left 0.22s ease;
      min-width: 0;
    }

    .shell.sidebar-open .main-wrap,
    html.sidebar-open .main-wrap {
      margin-left: var(--sidebar-width);
    }

    .main-inner {
      max-width: 860px;
      margin: 0 auto;
      padding: 2em 2.5rem 5rem;
    }

    /* ── Article Typography (is:global so it reaches markdown content) */
    .prose h1.page-title {
      font-size: 3rem;
      font-weight: 300;
      letter-spacing: -0.03em;
      line-height: 1.15;
      margin-bottom: 3rem;
    }
    .prose h1.page-title .title-en,
    .prose h1.page-title .title-ja {
      display: block;
    }
    .prose h1.page-title .title-ja {
      margin-top: 0.3em;
    }
    .prose h1 {
      font-size: 1.55rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.25;
      margin-top: 2.75rem;
      margin-bottom: 1.6rem;
    }
    .prose h2 {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-top: 2.25rem;
      margin-bottom: 1.6rem;
    }
    .prose h3 {
      font-size: 1.05rem;
      font-weight: 600;
      margin-top: 1.75rem;
      margin-bottom: 1.2rem;
    }
    /* Bilingual heading pairs: pull Japanese heading close to English, generous space after */
    .prose h1 + h1,
    .prose h2 + h2,
    .prose h3 + h3 {
      margin-top: -1rem;
      margin-bottom: 1.6rem;
    }

    /* ── Anchor link icons ────────────────────────────────────────── */
    .prose h1:not(.page-title),
    .prose h2,
    .prose h3 {
      position: relative;
    }
    .anchor-copy-btn {
      position: absolute;
      left: -1.9rem;
      width: 1.9rem; /* spans the full gap to the heading's left edge — no mouse-gap */
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      color: var(--fg-muted);
      transition: opacity 0.12s;
    }
    /* Center icon on the first line of each heading level.
       top = (font-size × line-height − icon-size) / 2 */
    .prose h1:not(.page-title) > .anchor-copy-btn {
      top: calc((1.55rem * 1.25 - 1rem) / 2);
    }
    .prose h2 > .anchor-copy-btn {
      top: calc((1.25rem * 1.7 - 1rem) / 2);
    }
    .prose h3 > .anchor-copy-btn {
      top: calc((1.05rem * 1.7 - 1rem) / 2);
    }
    .anchor-copy-btn .material-symbols-outlined {
      font-size: 1rem;
      line-height: 1;
      user-select: none;
    }
    .prose h1:not(.page-title):hover > .anchor-copy-btn,
    .prose h2:hover > .anchor-copy-btn,
    .prose h3:hover > .anchor-copy-btn,
    .anchor-copy-btn:hover {
      opacity: 1;
      pointer-events: auto;
    }
    /* Bilingual pairs: hide icon on the Japanese (second) heading */
    .prose h1:not(.page-title) + h1 > .anchor-copy-btn,
    .prose h2 + h2 > .anchor-copy-btn,
    .prose h3 + h3 > .anchor-copy-btn {
      display: none;
    }
    .prose p {
      margin-bottom: 2.1rem;
    }
    .prose a {
      color: var(--link);
      text-decoration: none;
    }
    .prose a:hover { opacity: 0.75; }
    .prose ul, .prose ol {
      padding-left: 1.5rem;
      margin-bottom: 2.1rem;
    }
    .prose li { margin-bottom: 0.6rem; }
    .prose li > ul, .prose li > ol { margin-top: 0.6rem; margin-bottom: 0; }
    .prose ul { list-style-type: '- '; }
    .prose .katex-display, .prose .katex-display .katex { text-align: left; }
    .prose .katex-display { margin-top: 1.2rem; margin-bottom: 1.8rem; }
    .katex-mathml {
      position: absolute;
      clip: rect(1px, 1px, 1px, 1px);
      height: 1px;
      width: 1px;
      overflow: hidden;
      padding: 0;
      border: 0;
    }
    .prose blockquote {
      border-left: 2px solid var(--border);
      padding-left: 1rem;
      color: var(--fg-muted);
      margin: 1rem 0;
    }
    .prose code {
      font-family: var(--font-code);
      font-size: 0.87em;
      background: #f5f5f5;
      padding: 0.15em 0.35em;
      border-radius: 3px;
    }
    .prose pre {
      font-family: var(--font-code);
      font-size: 0.87em;
      background: #f5f5f5;
      border-radius: 5px;
      padding: 1.25rem;
      overflow-x: auto;
      margin: 1.25rem 0;
    }
    .prose pre code {
      background: none;
      padding: 0;
    }
    .prose img {
      max-width: 100%;
      width: 100%;
      height: auto;
      display: block;
      border-radius: 4px;
      margin: 3rem auto;
    }
    .prose img[title="75"] { width: 75%; }
    .prose img[title="50"] { width: 50%; }
    .prose img[title="25"] { width: 25%; }
    /* Make image-wrapping links block so % widths are relative to content area */
    .prose a:has(> img) {
      display: block;
    }
    /* Style paragraphs immediately following an image-link as captions */
    .prose a:has(> img) + p,
    .prose img + p,
    .prose p:has(> a > img) + p,
    .prose p:has(> a > img) + p:has(> a > img) + p {
      font-size: 0.8em;
      color: var(--fg-muted);
      text-align: left;
      margin-top: -1.75rem;
      margin-bottom: 2.75rem;
      line-height: 1.5;
    }
    .prose a:has(> img) + p a,
    .prose img + p a,
    .prose p:has(> a > img) + p a,
    .prose p:has(> a > img) + p:has(> a > img) + p a {
      color: var(--fg-muted);
      text-decoration: underline;
    }
    .prose a:has(> img) + p a:hover,
    .prose img + p a:hover,
    .prose p:has(> a > img) + p a:hover,
    .prose p:has(> a > img) + p:has(> a > img) + p a:hover {
      color: var(--fg);
    }
    .prose .video-wrap {
      position: relative;
      width: 100%;
      padding-bottom: 56.25%; /* 16:9 */
      margin: 3rem 0;
    }
    .prose .video-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
      border-radius: 4px;
    }
    .prose .codepen-wrap {
      margin: 3rem 0;
      border-radius: 4px;
      overflow: hidden;
    }
    .prose .codepen-wrap p.codepen {
      margin: 0;
      border: none !important;
    }
    .prose .codepen-wrap iframe {
      display: block;
      border-radius: 4px;
      height: 504px !important;
    }
    .prose .video-embed {
      margin: 2rem 0;
      aspect-ratio: 16 / 9;
      width: 100%;
    }
    .prose .video-embed iframe {
      width: 100%;
      height: 100%;
      display: block;
      border: none;
      border-radius: 4px;
    }
    .prose .openprocessing-wrap {
      margin: 3rem 0;
      border-radius: 4px;
      overflow: hidden;
    }
    .prose .openprocessing-wrap iframe {
      display: block;
      width: 100%;
      border-radius: 4px;
    }
    /* Sound theory demos: a page from public/demos/ that fills the frame. */
    .prose .demo-wrap {
      margin: 3rem 0;
      border-radius: 4px;
      overflow: hidden;
    }
    .prose .demo-wrap iframe {
      display: block;
      width: 100%;
      height: 620px;
      border: none;
    }
    /* Sound theory demos: the record button under each demo (demoRecorder.js). */
    .prose .demo-wrap .demo-record {
      display: flex; align-items: center; gap: 0.4em;
      margin: 0.5rem 0 0 auto;
      padding: 0;
      background: none; border: none; cursor: pointer;
      font: inherit; font-size: 0.75rem; color: var(--fg-muted, #777);
    }
    .prose .demo-wrap .demo-record:hover { color: var(--fg, #000); }
    .prose .demo-wrap .demo-record-mark {
      display: inline-block; width: 0.6em; height: 0.6em;
      border-radius: 50%; background: #f05829;
    }
    .prose .demo-wrap .demo-record-mark.stop { border-radius: 0; background: currentColor; }
    .prose .local-video-wrap {
      margin: 3rem 0;
    }
    .prose .local-video-wrap video {
      width: 100%;
      border-radius: 4px;
      display: block;
    }
    .prose .instagram-wrap {
      margin: 3rem auto;
      max-width: 540px;
    }
    .prose .bookmark-card {
      margin: 2rem 0;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      transition: border-color 0.15s;
    }
    .prose .bookmark-card:hover { border-color: #bbb; }
    .prose .bookmark-link {
      display: flex;
      align-items: stretch;
      text-decoration: none;
      color: inherit;
      height: 8em;
      overflow: hidden;
    }
    .prose .bookmark-info {
      flex: 1 1 0;
      min-width: 0;
      padding: 0.85rem 1rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.3rem;
    }
    .prose .bookmark-title {
      font-size: 0.88em;
      font-weight: 500;
      color: var(--fg);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .prose .bookmark-description {
      font-size: 0.78em;
      color: var(--fg-muted);
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      line-height: 1.5;
    }
    .prose .bookmark-url {
      font-size: 0.72em;
      color: var(--fg-muted);
      display: flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .prose .bookmark-url span {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .prose .bookmark-favicon {
      width: 14px !important;
      height: 14px !important;
      flex-shrink: 0;
      object-fit: contain;
      border-radius: 0;
      margin: 0;
      display: inline-block;
    }
    .prose .bookmark-image {
      width: auto !important;
      height: 100%;
      flex-shrink: 0;
      object-fit: contain;
      display: block;
      border-radius: 0;
      margin: 0;
    }
    @media (max-width: 540px) {
      .prose .bookmark-image { display: none; }
    }
    .prose .image-row {
      display: flex;
      gap: 1em;
      align-items: flex-start;
    }
    .prose .image-row figure {
      flex: 1;
      margin: 0;
    }
    .prose .image-row img {
      width: 100%;
      height: auto;
    }
    .prose hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2rem 0;
    }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.25rem 0;
      font-size: 0.9em;
    }
    .prose th, .prose td {
      border: 1px solid var(--border);
      padding: 0.5rem 0.75rem;
      text-align: left;
    }
    .prose th { font-weight: 600; background: #fafafa; }
    .prose figure img { margin: 0; }
    .prose figure { margin-bottom: 2rem; }
    .prose figcaption {
      font-size: 0.8em;
      color: #666;
      margin-top: 0.5rem;
      margin-bottom: 2rem;
      line-height: 1.5;
    }
    .prose figure img + figcaption,
    .prose figure img + * + figcaption {
      margin-top: -2rem;
      margin-bottom: 3rem;
    }
    .prose table.matrix-table {
      width: auto;
      font-family: var(--font-code);
      font-size: 0.85em;
    }
    .prose table.matrix-table td {
      text-align: left;
      padding: 0.3rem 0.75rem;
      min-width: 3rem;
    }
    .prose details {
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.5rem 0.75rem;
      margin: 0.75rem 0;
    }
    .prose summary { cursor: pointer; font-weight: 500; }

    .prose aside {
      display: flex;
      gap: 0.75rem;
      background: #f7f7f7;
      border-radius: 6px;
      padding: 0.9rem 1rem;
      margin: 1.25rem 0;
      font-size: 0.875rem;
      line-height: 1.6;
    }
    .prose aside .aside-icon {
      flex-shrink: 0;
      font-size: 1.1rem;
      line-height: 1.6;
    }
    .prose aside .aside-body > * + * { margin-top: 0.35rem; }
    .prose aside .aside-body p { margin: 0; }
    .prose aside .aside-body a { text-decoration: underline; }

    /* ── Site Footer ─────────────────────────────────────────────── */
    .site-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      margin-top: 4rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--fg-muted);
    }
    .site-footer a {
      color: var(--fg-muted);
      text-decoration: none;
    }
    .site-footer a:hover { color: var(--fg); }
    .site-footer-left, .site-footer-right {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .site-footer-feedback {
      width: 100%;
      line-height: 1.6;
    }

    /* ── Mobile ───────────────────────────────────────────────────── */
    @media (max-width: 768px) {
      .shell.sidebar-open .main-wrap,
      html.sidebar-open .main-wrap {
        margin-left: 0;
      }
      .main-inner {
        padding: 1.5rem 1.25rem 3rem;
      }
      .prose h1 { font-size: 1.5rem; }
    }

    /* ── Search ───────────────────────────────────────────────────── */
    .topbar-search-wrap {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      pointer-events: all;
    }
    .search-input {
      width: 280px;
      padding: 0.3rem 0.7rem;
      font-family: var(--font-body);
      font-size: 0.8rem;
      background: rgba(255,255,255,0.9);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--fg);
      outline: none;
    }
    .search-input:focus { border-color: var(--fg-muted); }
    .search-input::placeholder { color: #bbb; }

    #search-view {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      padding: 2.5rem 2rem 6rem;
    }
    html.sidebar-open #search-view { margin: 0 auto; }
    .search-status {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.85rem;
      color: var(--fg-muted);
      margin-bottom: 1.5rem;
      padding-top: var(--header-height);
    }
    .search-clear {
      background: none; border: none; cursor: pointer;
      color: var(--fg-muted); font-family: inherit; font-size: 0.8rem;
    }
    .search-clear:hover { color: var(--fg); }
    .results { list-style: none; }
    .result { padding: 1.2rem 0; border-top: 1px solid var(--border); }
    .result:first-child { border-top: none; }
    .result a.result-link { color: var(--fg); display: block; text-decoration: none; }
    .result a.result-link:hover { color: var(--link); }
    .result-title { font-size: 1.05rem; font-weight: 600; line-height: 1.3; }
    .result-title .ja { color: var(--fg-muted); font-weight: 400; margin-left: 0.4rem; font-size: 0.9em; }
    .result-summary { font-size: 0.85rem; color: var(--fg-muted); margin-top: 0.3rem; line-height: 1.5; }
    .result-summary-ja { margin-top: 0.1rem; }
    .result-score { font-size: 0.72rem; color: #bbb; margin-top: 0.25rem; }

    @media (max-width: 700px) {
      #search-view { margin-left: 0; padding: 2rem 1.25rem 4rem; }
      .topbar-search-wrap { padding: 0 0.25rem; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-controls topbar-controls-left">
      <button class="topbar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar">
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <line x1="0" y1="1" x2="18" y2="1"/>
          <line x1="0" y1="7" x2="18" y2="7"/>
          <line x1="0" y1="13" x2="18" y2="13"/>
        </svg>
      </button>
    </div>
    <div class="topbar-search-wrap" id="topbar-search-wrap">
      <input id="q" class="search-input" type="text" autocomplete="off"
        placeholder="Search…" data-base={base} aria-label="Search pages" />
    </div>
    <div class="topbar-controls topbar-controls-right">
      <div class="topbar-font-switcher">
        <button class="font-opt" id="font-btn-serif" style="font-family:'Lora','Noto Serif JP',serif">Serif</button>
        <span class="font-sep">|</span>
        <button class="font-opt" id="font-btn-sans" style="font-family:'Sora','Noto Sans JP',sans-serif">Sans</button>
      </div>
    </div>
  </header>

  <div class="shell" id="app-shell">
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <nav class="sidebar" aria-label="Site navigation">
      <a href={base || '/'} class={`sl sidebar-home${filePath === '' ? ' current' : ''}`} style="padding-left:36px; margin-bottom:0.25rem">kynd.info/writing/</a>
      <Sidebar tree={tree} currentSlug={filePath} />
    </nav>

    <div id="search-view" hidden></div>

    <main class="main-wrap" id="page-view">
      <div class="main-inner">
        <article class="prose">
          {breadcrumbs.length > 2 && (
            <nav class="content-breadcrumb" aria-label="Breadcrumb">
              {breadcrumbs.slice(0, -1).map((crumb, i) => (
                <span style="display:contents">
                  {i > 0 && <span class="cb-sep">/</span>}
                  <a href={crumb.href}>{crumb.label}</a>
                </span>
              ))}
            </nav>
          )}
          <slot />
        </article>
        <footer class="site-footer">
          <div class="site-footer-left">
            <a href={base || '/'}>kynd.info/writing/</a>
            <a href={`${base}/faq`}>FAQs</a>
            <a href="https://github.com/kynd/writing/discussions" target="_blank" rel="noopener">Feedback</a>
          </div>
<div class="site-footer-right">
            <a href="https://www.kynd.info/" target="_blank" rel="noopener">kynd.info</a>
            <a href="https://www.instagram.com/kyndinfo/" target="_blank" rel="noopener">Instagram</a>
            <a href="https://vimeo.com/kynd" target="_blank" rel="noopener">Vimeo</a>
            <a href="https://bsky.app/profile/kyndinfo.bsky.social" target="_blank" rel="noopener">Bluesky</a>
            <a href="https://www.threads.net/@kyndinfo" target="_blank" rel="noopener">Threads</a>
            <a href="https://twitter.com/kyndinfo" target="_blank" rel="noopener">Twitter</a>
          </div>
        </footer>
      </div>
    </main>
  </div>

  <script>
    const STORAGE_KEY = 'sidebar-open';
    const shell = document.getElementById('app-shell')!;
    const toggleBtn = document.getElementById('sidebar-toggle')!;
    const backdrop = document.getElementById('sidebar-backdrop')!;
    const isMobile = () => window.innerWidth <= 768;

    function applyState(open: boolean) {
      shell.classList.toggle('sidebar-open', open);
      document.documentElement.classList.toggle('sidebar-open', open);
      localStorage.setItem(STORAGE_KEY, String(open));
    }

    const stored = localStorage.getItem(STORAGE_KEY);
    shell.classList.add('no-transition');
    applyState(stored === 'true');
    requestAnimationFrame(() => shell.classList.remove('no-transition'));

    toggleBtn.addEventListener('click', () => {
      applyState(!shell.classList.contains('sidebar-open'));
    });

    backdrop.addEventListener('click', () => applyState(false));

    document.addEventListener('click', (e) => {
      if (!shell.classList.contains('sidebar-open')) return;
      const sidebar = document.querySelector('.sidebar')!;
      if (!sidebar.contains(e.target as Node) && !toggleBtn.contains(e.target as Node)) {
        applyState(false);
      }
    });

    // Font switcher
    const FONT_KEY = 'font-mode';
    const btnSerif = document.getElementById('font-btn-serif')!;
    const btnSans = document.getElementById('font-btn-sans')!;
    function applyFont(mode: string) {
      document.documentElement.setAttribute('data-font', mode);
      localStorage.setItem(FONT_KEY, mode);
      btnSerif.classList.toggle('active', mode === 'serif');
      btnSans.classList.toggle('active', mode === 'sans');
    }
    applyFont(localStorage.getItem(FONT_KEY) || 'serif');
    btnSerif.addEventListener('click', () => applyFont('serif'));
    btnSans.addEventListener('click', () => applyFont('sans'));

    // Click image to open in new tab
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        window.open(img.src, '_blank', 'noopener');
      });
    });
  </script>
  <script>
    function alignCaptions() {
      document.querySelectorAll('.prose p > a > img').forEach(img => {
        const caption = img.closest('p')?.nextElementSibling;
        if (!caption || caption.tagName !== 'P' || caption.querySelector('img')) return;
        const w = img.offsetWidth;
        if (w > 0) caption.style.maxWidth = w + 'px';
      });
    }
    window.addEventListener('load', alignCaptions);
    window.addEventListener('resize', alignCaptions);
  </script>
  <script>
    (function () {
      function slugify(text: string): string {
        return text.trim()
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/^-+|-+$/g, '');
      }

      const seen: Record<string, number> = {};

      function uniqueId(base: string): string {
        if (!base) {
          base = 'section';
        }
        if (!seen[base]) {
          seen[base] = 1;
          return base;
        }
        seen[base]++;
        return base + '-' + seen[base];
      }

      document.querySelectorAll<HTMLElement>(
        '.prose h1:not(.page-title), .prose h2, .prose h3'
      ).forEach((heading) => {
        const id = uniqueId(slugify(heading.textContent || ''));
        heading.id = id;

        const btn = document.createElement('button');
        btn.className = 'anchor-copy-btn';
        btn.setAttribute('aria-label', 'Copy link to section');
        btn.innerHTML = '<span class="material-symbols-outlined">link</span>';

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const url = window.location.origin + window.location.pathname + '#' + id;
          navigator.clipboard.writeText(url).catch(() => {
            const ta = document.createElement('textarea');
            ta.value = url;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          });
        });

        heading.prepend(btn);
      });

      // Bilingual pairs: hovering the Japanese (second) heading shows the English icon
      document.querySelectorAll<HTMLElement>(
        '.prose h1:not(.page-title) + h1, .prose h2 + h2, .prose h3 + h3'
      ).forEach((jaHeading) => {
        const enHeading = jaHeading.previousElementSibling as HTMLElement | null;
        const enBtn = enHeading?.querySelector<HTMLElement>('.anchor-copy-btn');
        if (!enBtn) return;
        jaHeading.addEventListener('mouseenter', () => {
          enBtn.style.opacity = '1';
          enBtn.style.pointerEvents = 'auto';
        });
        jaHeading.addEventListener('mouseleave', () => {
          enBtn.style.opacity = '';
          enBtn.style.pointerEvents = '';
        });
      });
    })();
  </script>

  <script>
    // ── Semantic search ───────────────────────────────────────────────
    import { pipeline } from 'https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2';

    const input = document.getElementById('q') as HTMLInputElement;
    const base = input?.dataset.base || '';
    const pageView = document.getElementById('page-view') as HTMLElement;
    const searchView = document.getElementById('search-view') as HTMLElement;

    let docs: any[] = [];
    let indexLoaded: Promise<void> | null = null;
    let extractor: any = null;
    let modelLoading: Promise<any> | null = null;

    function splitTitle(title: string) {
      const m = title.match(/[぀-鿿＀-￯]/);
      if (!m || m.index === undefined) return { en: title, ja: '' };
      const lastSpace = title.lastIndexOf(' ', m.index - 1);
      if (lastSpace === -1) return { en: title, ja: '' };
      return { en: title.slice(0, lastSpace).trim(), ja: title.slice(lastSpace + 1).trim() };
    }
    function cosine(a: number[], b: number[]) {
      let dot = 0, na = 0, nb = 0;
      for (let i = 0; i < a.length; i++) { dot += a[i] * b[i]; na += a[i] * a[i]; nb += b[i] * b[i]; }
      return dot / (Math.sqrt(na) * Math.sqrt(nb) || 1);
    }
    function loadIndex() {
      if (!indexLoaded) {
        indexLoaded = fetch(`${base}/search-index.json`).then((r) => r.json()).then((d) => { docs = d; });
      }
      return indexLoaded;
    }
    async function ensureModel() {
      if (extractor) return extractor;
      if (!modelLoading) modelLoading = pipeline('feature-extraction', 'Xenova/all-MiniLM-L6-v2');
      extractor = await modelLoading;
      return extractor;
    }
    async function embed(text: string): Promise<number[]> {
      const model = await ensureModel();
      const out = await model(text, { pooling: 'mean', normalize: true });
      return Array.from(out.data as Float32Array);
    }

    function showPage() {
      searchView.hidden = true;
      pageView.hidden = false;
    }
    function render(query: string, list: any[]) {
      const items = list.map((d) => {
        const { en, ja } = splitTitle(d.title);
        const score = d.score != null ? `<div class="result-score">${Math.min(99, Math.round(d.score * 100))}% match</div>` : '';
        const summaryJa = d.summaryJa ? `<div class="result-summary result-summary-ja">${d.summaryJa}</div>` : '';
        return `<li class="result"><a class="result-link" href="${base}/${d.slug}">
          <div class="result-title">${en}${ja ? `<span class="ja">${ja}</span>` : ''}</div>
          <div class="result-summary">${d.summary}</div>${summaryJa}${score}
        </a></li>`;
      }).join('');
      searchView.innerHTML = `
        <div class="search-status">
          <span>${list.length} result${list.length === 1 ? '' : 's'} for "${query}"</span>
          <button class="search-clear" id="search-clear">Clear ✕</button>
        </div>
        <ul class="results">${items || '<li class="result">No matching pages.</li>'}</ul>`;
      document.getElementById('search-clear')!.addEventListener('click', clearSearch);
      pageView.hidden = true;
      searchView.hidden = false;
    }
    function clearSearch() {
      input.value = '';
      showPage();
      window.scrollTo(0, 0);
    }

    async function runSearch(query: string) {
      const q = query.trim();
      if (!q) { showPage(); return; }
      await loadIndex();
      searchView.innerHTML = `<div class="search-status"><span>Searching "${q}"… (first search loads a small model)</span></div>`;
      pageView.hidden = true;
      searchView.hidden = false;
      const vec = await embed(q);
      const ql = q.toLowerCase();
      const tokens = ql.split(/\s+/).filter((w) => w.length > 1);
      const ranked = docs
        .map((d) => {
          const sem = cosine(vec, d.vector);
          const t = d.text || '';
          let lex = 0;
          if (t.includes(ql)) lex = 1;
          else if (tokens.length && tokens.every((w) => t.includes(w))) lex = 0.7;
          return { ...d, score: sem + 0.5 * lex };
        })
        .filter((d) => d.score > 0.18)
        .sort((x, y) => y.score - x.score);
      render(q, ranked);
    }

    let timer: any;
    input?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => runSearch(input.value), 220);
    });

    // Preload index so first search is snappy.
    loadIndex();
  </script>
  <!-- Sound theory demos: a record button under each embedded demo. -->
  <script is:inline type="module" src={`${base}/lib/page/demoRecorder.js`}></script>
</body>
</html>
